{
  "name": "alpha-trading-system",
  "version": "3.0.0",
  "description": "ALPHA TRADING SYSTEM — 스펙터+독개미+경제명탐정+고고저 통합 AI 트레이딩 웹앱",
  "private": true,
  "scripts": {
    "dev": "npm run sync:ios && concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "test": "node --test test/*.test.js",
    "server:watch": "nodemon server.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "sync:ios": "node scripts/sync-ios-api-config.mjs",
    "sync:ios:release": "node scripts/sync-ios-api-config.mjs release",
    "archive:ios": "bash AlphaTradingIOS/scripts/archive-testflight.sh",
    "archive:ios:auto": "bash AlphaTradingIOS/scripts/auto-archive.sh",
    "fix-codesign-keychain": "bash AlphaTradingIOS/scripts/fix-codesign-keychain.sh",
    "setup:asc": "bash AlphaTradingIOS/scripts/setup-asc-api-key.sh",
    "verify:asc": "bash AlphaTradingIOS/scripts/verify-asc-api-key.sh",
    "probe:asc": "node AlphaTradingIOS/scripts/asc-jwt-probe.mjs",
    "normalize:asc": "bash scripts/normalize-asc-env.sh",
    "export:asc-secrets": "bash scripts/export-github-asc-secrets.sh",
    "encode:asc-cloud": "bash AlphaTradingIOS/scripts/encode-asc-key-for-cloud.sh",
    "xcode-cloud:md": "bash AlphaTradingIOS/scripts/fix-xcode-cloud-workflow.command",
    "xcode-cloud:stage1": "bash AlphaTradingIOS/scripts/apply-workflow-stage1-only.command",
    "xcode-cloud:stage2": "bash AlphaTradingIOS/scripts/apply-stage2-workflow.command",
    "xcode-cloud:stage3": "bash AlphaTradingIOS/scripts/apply-stage3-workflow.command",
    "xcode-cloud:setup": "bash AlphaTradingIOS/scripts/run-xcode-cloud-setup-and-build.command",
    "preflight:ios": "bash AlphaTradingIOS/scripts/run-local-ci-preflight.sh"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^10.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

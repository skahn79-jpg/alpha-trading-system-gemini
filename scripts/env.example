# 웹앱 + iOS 공통 API 설정 예시
# 프로젝트 루트에 .env.local 로 복사 후 사용
# iOS 동기화: npm run sync:ios

VITE_API_URL=https://alpha-trading-server.onrender.com
VITE_APP_API_KEY=

KIS_APP_KEY=
KIS_APP_SECRET=
DART_API_KEY=
GEMINI_API_KEY=
APP_API_KEY=

# (선택) TestFlight / App Store Connect API Key
# ASC_API_KEY_ID=
# ASC_ISSUER_ID=
# ASC_API_KEY_PATH=/path/to/AuthKey_XXXXXX.p8

# (선택) 또는 앱 전용 비밀번호
# APPLE_ID=your@email.com
# APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

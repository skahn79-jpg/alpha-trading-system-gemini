# 웹앱 + iOS 앱 공통 API 설정
# 사용법: 이 파일을 .env.local 로 복사 후 값 입력
# iOS: npm run sync:ios 또는 Xcode 빌드 시 자동 동기화

# Render API 서버 URL (비우면 웹=Render, iOS Debug=localhost:3001)
VITE_API_URL=https://alpha-trading-server.onrender.com

# iOS/웹 클라이언트 인증 키 (Render APP_API_KEY 와 동일)
VITE_APP_API_KEY=

# ── 서버 전용 (server.js) ──
KIS_APP_KEY=
KIS_APP_SECRET=
DART_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_API_KEY=
ALERT_CHECK_SECRET=

# ── 단일 관리자 인증 (값 없음 — 실제 비밀번호/해시를 이 파일에 넣지 마세요) ──
ADMIN_LOGIN_ID=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_MINUTES=60

# ── KB증권 Open API (조회 전용. 앱키·시크릿 값을 이 파일에 넣지 마세요) ──
KBSEC_BASE_URL=https://developer.kbsec.com:32484
KBSEC_APP_KEY=
KBSEC_APP_SECRET=
KBSEC_IP_ADDR=
KBSEC_MAC_ADDR=
KBSEC_TRADING_ENABLED=false
KBSEC_AUTO_TRADING_ENABLED=false

# ── TestFlight / App Store Connect API (로컬 업로드·CI) ──
# App Store Connect → 사용자 및 액세스 → 통합 → App Store Connect API
ASC_API_KEY_ID=
ASC_ISSUER_ID=
ASC_API_KEY_PATH=/path/to/AuthKey_XXXXXX.p8
